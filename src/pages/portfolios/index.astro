---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const projects = (await getCollection("portfolios")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title={`Portfolios | ${config.site.title}`}
  description="My completed projects"
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Portfolios">
    <ul class="space-y-8">
      {
        projects.map(({ id, data }) => (
          <li class="border-border border-b pb-6">
            <h2 class="text-xl font-semibold">
              <a
                href={getRelativeLocaleUrl(locale, `portfolios/${id}`)}
                class="text-accent underline-offset-4 hover:underline"
              >
                {data.title}
              </a>
            </h2>
            <p class="my-2">{data.description}</p>
            <p class="text-sm opacity-80">{data.tags.join(" · ")}</p>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>